// Prisma schema for PostgreSQL (Neon). Adjust models as needed.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  lives         Int      @default(5)
  isPremium     Boolean  @default(true)
  downloads_used Int     @default(0)
  isVerified    Boolean  @default(false) // New field to track email verification
  profileImgId  Int?     @default(1) // Profile image ID (0, 1, etc.)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  otp           Otp?     @relation("UserOtp") // Define the relation without fields/references here
}

model Otp {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique // Link to User
  hashedOtp     String   // Hashed OTP for security
  expiry        DateTime // Expiry time for the OTP
  attempts      Int      @default(0) // Track verification attempts
  createdAt     DateTime @default(now())

  user          User     @relation("UserOtp", fields: [userId], references: [id], onDelete: Cascade)
}

model PendingSignup {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String   @unique
  password_hash String
  hashedOtp     String
  expiry        DateTime
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
}
